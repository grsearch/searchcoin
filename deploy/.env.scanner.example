SERVER_ROLE=scanner
HOST=0.0.0.0
PORT=8000

# scanner -> strategy relay endpoint
STRATEGY_INGEST_URL=http://strategy-host:8000/api/strategy/smart-wallets/ingest
INTER_SERVER_SHARED_TOKEN=change_me

# discovery runtime
SMART_WALLET_AUTO_REFRESH_ENABLED=true
SMART_WALLET_REFRESH_INTERVAL_SECONDS=3600
SMART_WALLET_REFRESH_ON_STARTUP=true

# upstream APIs
BIRDEYE_API_KEY=
BIRDEYE_BASE_URL=https://public-api.birdeye.so
